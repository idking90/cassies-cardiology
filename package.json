{
  "name": "cassies-cardiology",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:pages": "npm run build && wrangler pages dev",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "d1:migrate:local": "wrangler d1 migrations apply cassies-cardiology --local",
    "d1:migrate:remote": "wrangler d1 migrations apply cassies-cardiology --remote",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler pages deploy dist"
  },
  "dependencies": {
    "jose": "^6.2.8",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "oxlint": "^1.75.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "wrangler": "^4.120.0"
  }
}
